# ----------------------------------------------------------------------------
# Pre-Payment Validation Agent - environment configuration
# Copy to .env and edit. Every value is optional; sensible defaults are used.
# ----------------------------------------------------------------------------

# Narrative provider(s): template | anthropic | groq | openai
# "template" is fully offline and needs no API key.
# You can set a SINGLE provider (e.g. LLM_PROVIDER=groq) OR an ordered fallback
# CHAIN, comma-separated and tried left-to-right, e.g.:
#     LLM_PROVIDER=anthropic,groq
# The offline template is ALWAYS the final fallback when
# LLM_FALLBACK_TO_TEMPLATE=true, so you don't need to append it explicitly.
# For a fully offline run with no keys, set:  LLM_PROVIDER=template
LLM_PROVIDER=anthropic,groq

# --- Anthropic Claude ---
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# --- Groq (LLaMA) ---
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=llama-3.3-70b-versatile

# --- OpenAI ---
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# If a remote provider fails, fall back to the offline template (default: true)
LLM_FALLBACK_TO_TEMPLATE=true

# --- Paths (optional overrides) ---
# PREPAY_REFERENCE_DIR=reference_data
# PREPAY_OUTPUT_DIR=outputs

# --- Validation thresholds (optional overrides) ---
# PREPAY_AMOUNT_TOLERANCE_PCT=0.5
# PREPAY_DUP_WINDOW_DAYS=30
# PREPAY_HISTORY_LOOKBACK_DAYS=90
# PREPAY_CURRENCY=USD
# PREPAY_CURRENCY_SYMBOL=$
